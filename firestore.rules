rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return isSignedIn() &&
             request.auth.token.email is string &&
             request.auth.token.email.lower() == 'pafm77pedrinho77@gmail.com';
    }

    function isStudioMember(userId) {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/users/$(userId)/portal_members/$(request.auth.uid));
    }

    function canAccessStudio(userId) {
      return isOwner(userId) || isStudioMember(userId);
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    // --- Validation Helpers ---
    function isValidClient(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
             data.phone is string && data.phone.size() <= 20 &&
             data.notes is string && data.notes.size() <= 500 &&
             data.active is bool &&
             data.newClient is bool &&
             (!('monthlyFeeEur' in data) || (data.monthlyFeeEur is number && data.monthlyFeeEur >= 0 && data.monthlyFeeEur <= 100000)) &&
             (!('fidelizacaoMonths' in data) || (data.fidelizacaoMonths in [0, 6, 12])) &&
             (!('fidelizacaoStartMillis' in data) || (data.fidelizacaoStartMillis is int && data.fidelizacaoStartMillis >= 0)) &&
             (!('trainingType' in data) || (data.trainingType in ['PERSONALIZADO', 'GRUPO'])) &&
             (!('weeklySessionLimit' in data) || (data.weeklySessionLimit is int && data.weeklySessionLimit >= 0 && data.weeklySessionLimit <= 21)) &&
             (!('fixedSlots' in data) || (data.fixedSlots is list && data.fixedSlots.size() <= 21)) &&
             (!('loginPinHash' in data) || (data.loginPinHash is string && data.loginPinHash.size() <= 160)) &&
             (!('birthDate' in data) || (data.birthDate is string && (data.birthDate == '' || data.birthDate.matches('^\\d{4}-\\d{2}-\\d{2}$')))) &&
             (!('weeklyGoalSessions' in data) || (data.weeklyGoalSessions is int && data.weeklyGoalSessions >= 0 && data.weeklyGoalSessions <= 14));
    }

    function isValidDayWorkoutTypes(m) {
      return m is map &&
             m.keys().hasOnly(['1', '2', '3', '4', '5', '6', '7']) &&
             (!('1' in m) || (m['1'] is string && m['1'].size() <= 60)) &&
             (!('2' in m) || (m['2'] is string && m['2'].size() <= 60)) &&
             (!('3' in m) || (m['3'] is string && m['3'].size() <= 60)) &&
             (!('4' in m) || (m['4'] is string && m['4'].size() <= 60)) &&
             (!('5' in m) || (m['5'] is string && m['5'].size() <= 60)) &&
             (!('6' in m) || (m['6'] is string && m['6'].size() <= 60)) &&
             (!('7' in m) || (m['7'] is string && m['7'].size() <= 60));
    }

    function isValidWeek(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.weekKey is string && data.weekKey.size() >= 1 && data.weekKey.size() <= 30 &&
             data.label is string && data.label.size() >= 1 && data.label.size() <= 50 &&
             data.startDateMillis is int &&
             data.published is bool &&
             (!('showDayWorkoutTypes' in data) || data.showDayWorkoutTypes is bool) &&
             (!('dayWorkoutTypes' in data) || isValidDayWorkoutTypes(data.dayWorkoutTypes));
    }

    function isValidSession(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.weekKey is string && data.weekKey.size() >= 1 && data.weekKey.size() <= 30 &&
             data.dayOfWeek is int && data.dayOfWeek >= 1 && data.dayOfWeek <= 7 &&
             data.dateLabel is string && data.dateLabel.size() >= 1 && data.dateLabel.size() <= 50 &&
             data.timeLabel is string && data.timeLabel.size() >= 1 && data.timeLabel.size() <= 20 &&
             data.durationMinutes is int && data.durationMinutes >= 10 && data.durationMinutes <= 300 &&
             data.capacity is int && data.capacity >= 1 && data.capacity <= 100 &&
             data.note is string && data.note.size() <= 200 &&
             data.startMillis is int &&
             (!('ptPrivatePersonal' in data) || data.ptPrivatePersonal is bool);
    }

    function isValidBooking(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.sessionId is string && data.sessionId.size() >= 1 && data.sessionId.size() <= 128 &&
             data.weekKey is string && data.weekKey.size() >= 1 && data.weekKey.size() <= 30 &&
             data.clientId is string && data.clientId.size() >= 1 && data.clientId.size() <= 128 &&
             data.status in ['PENDING', 'CONFIRMED', 'ALTERED', 'CANCELLED'] &&
             (!('attendanceStatus' in data) || (data.attendanceStatus in ['', 'PENDING', 'PRESENT', 'ABSENT'])) &&
             data.requestedAtMillis is int;
    }

    function isValidWeekResponse(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.weekKey is string && data.weekKey.size() >= 1 && data.weekKey.size() <= 30 &&
             data.clientId is string && data.clientId.size() >= 1 && data.clientId.size() <= 128 &&
             data.status in ['UNAVAILABLE', 'REMINDED'];
    }

    function isValidPayment(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.clientId is string && data.clientId.size() >= 1 && data.clientId.size() <= 128 &&
             data.monthYear is string && data.monthYear.size() >= 1 && data.monthYear.size() <= 20 &&
             data.monthLabel is string && data.monthLabel.size() >= 1 && data.monthLabel.size() <= 30 &&
             data.amountEur is number && data.amountEur >= 0 && data.amountEur <= 100000 &&
             data.paid is bool &&
             data.paidAtMillis is int &&
             data.note is string && data.note.size() <= 200;
    }

    function isValidFidelizacao(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.clientId is string && data.clientId.size() >= 1 && data.clientId.size() <= 128 &&
             data.durationMonths in [6, 12] &&
             data.startDateMillis is int &&
             data.endDateMillis is int &&
             data.notes is string && data.notes.size() <= 300;
    }

    function isValidExercise(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
             data.muscleGroup is string && data.muscleGroup.size() >= 1 && data.muscleGroup.size() <= 40 &&
             data.equipment is string && data.equipment.size() <= 60 &&
             data.instructions is string && data.instructions.size() <= 600 &&
             data.custom is bool;
    }

    function isValidWorkoutPlan(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.clientId is string && data.clientId.size() <= 128 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.splitLabel is string && data.splitLabel.size() <= 120 &&
             (!('availableFromDate' in data) || (data.availableFromDate is string && (data.availableFromDate == '' || data.availableFromDate.matches('^\\d{4}-\\d{2}-\\d{2}$')))) &&
             data.createdAtMillis is int;
    }

    function isValidWorkoutPlanItem(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.planId is string && data.planId.size() >= 1 && data.planId.size() <= 128 &&
             data.exerciseId is string && data.exerciseId.size() <= 128 &&
             data.exerciseName is string && data.exerciseName.size() >= 1 && data.exerciseName.size() <= 120 &&
             data.muscleGroup is string && data.muscleGroup.size() >= 1 && data.muscleGroup.size() <= 40 &&
             data.sets is int && data.sets >= 1 && data.sets <= 30 &&
             data.reps is string && data.reps.size() >= 1 && data.reps.size() <= 40 &&
             data.loadKg is string && data.loadKg.size() <= 40 &&
             (!('lastLoadKg' in data) || (data.lastLoadKg is string && data.lastLoadKg.size() <= 40)) &&
             (!('lastLoggedAtMillis' in data) || (data.lastLoggedAtMillis is int && data.lastLoggedAtMillis >= 0)) &&
             data.restSeconds is int && data.restSeconds >= 0 && data.restSeconds <= 600 &&
             data.notes is string && data.notes.size() <= 300 &&
             data.orderIndex is int && data.orderIndex >= 0 && data.orderIndex <= 200 &&
             (!('supersetGroup' in data) || (data.supersetGroup is string && data.supersetGroup.size() <= 40));
    }

    function isValidFoodItem(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 40 &&
             data.kcalPer100g is number && data.kcalPer100g >= 0 &&
             data.proteinPer100g is number && data.proteinPer100g >= 0 &&
             data.carbsPer100g is number && data.carbsPer100g >= 0 &&
             data.fatPer100g is number && data.fatPer100g >= 0 &&
             data.custom is bool;
    }

    function isValidNutritionEntry(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.clientId is string && data.clientId.size() >= 1 && data.clientId.size() <= 128 &&
             data.mealType is string && data.mealType.size() >= 1 && data.mealType.size() <= 40 &&
             data.foodId is string && data.foodId.size() <= 128 &&
             data.foodName is string && data.foodName.size() >= 1 && data.foodName.size() <= 120 &&
             data.grams is number && data.grams > 0 && data.grams <= 10000 &&
             data.kcal is number && data.kcal >= 0 &&
             data.protein is number && data.protein >= 0 &&
             data.carbs is number && data.carbs >= 0 &&
             data.fat is number && data.fat >= 0;
    }

    function isValidChatMessage(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.clientId is string && data.clientId.size() >= 1 && data.clientId.size() <= 128 &&
             data.senderRole in ['PT', 'STUDENT'] &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 2000 &&
             data.timestampMillis is int &&
             (!('deliveredAtMillis' in data) || (data.deliveredAtMillis is int && data.deliveredAtMillis >= 0)) &&
             (!('readAtMillis' in data) || (data.readAtMillis is int && data.readAtMillis >= 0));
    }

    function isValidMessageTemplate(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.templateKey is string && data.templateKey.size() >= 1 && data.templateKey.size() <= 40 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 80 &&
             data.description is string && data.description.size() <= 200 &&
             data.body is string && data.body.size() >= 1 && data.body.size() <= 1500 &&
             data.defaultBody is string && data.defaultBody.size() >= 1 && data.defaultBody.size() <= 1500;
    }

    function isValidStudioSettings(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.clientsCanEdit is bool &&
             data.cutoffHours is int && data.cutoffHours >= 0 && data.cutoffHours <= 72 &&
             (!('cutoffMinutes' in data) || (data.cutoffMinutes is int && data.cutoffMinutes >= 0 && data.cutoffMinutes <= 4320)) &&
             (!('reminderLeadMinutes' in data) || (data.reminderLeadMinutes is int && data.reminderLeadMinutes >= 5 && data.reminderLeadMinutes <= 1440)) &&
             data.whatsappWebMode is bool &&
             data.siteBaseUrl is string && data.siteBaseUrl.size() >= 1 && data.siteBaseUrl.size() <= 300 &&
             (!('studentPortalCode' in data) || (data.studentPortalCode is string && data.studentPortalCode.size() <= 64)) &&
             (!('ptWhatsappPhone' in data) || (data.ptWhatsappPhone is string && data.ptWhatsappPhone.size() <= 20)) &&
             (!('birthDateReminderUntilMillis' in data) || (data.birthDateReminderUntilMillis is int && data.birthDateReminderUntilMillis >= 0)) &&
             data.seeded is bool;
    }

    function isValidPtAccount(data) {
      return data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
             data.displayName is string && data.displayName.size() <= 120 &&
             data.status in ['PENDING', 'APPROVED', 'REJECTED'] &&
             data.isAdmin is bool &&
             data.requestedAtMillis is int && data.requestedAtMillis >= 0 &&
             data.reviewedAtMillis is int && data.reviewedAtMillis >= 0;
    }

    function isValidPtNotification(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.clientId is string && data.clientId.size() >= 1 && data.clientId.size() <= 128 &&
             data.clientName is string && data.clientName.size() >= 1 && data.clientName.size() <= 100 &&
             data.type in ['CANCELLED', 'ALTERED', 'UNAVAILABLE', 'ASSESSMENT', 'CHAT', 'FEEDBACK'] &&
             data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 400 &&
             data.weekKey is string && data.weekKey.size() <= 30 &&
             data.read is bool &&
             data.timestampMillis is int && data.timestampMillis >= 0;
    }

    function isValidPhysicalAssessment(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.clientId is string && data.clientId.size() >= 1 && data.clientId.size() <= 128 &&
             data.dateMillis is int && data.dateMillis >= 0 &&
             data.weightKg is number && data.weightKg > 0 && data.weightKg <= 500 &&
             data.ageYears is int && data.ageYears >= 5 && data.ageYears <= 120 &&
             data.heightCm is number && data.heightCm >= 50 && data.heightCm <= 260 &&
             data.sex in ['M', 'F'] &&
             data.bodyFatPct is number && data.bodyFatPct >= 0 && data.bodyFatPct <= 80 &&
             data.muscleMassKg is number && data.muscleMassKg >= 0 && data.muscleMassKg <= 200 &&
             data.visceralFat is number && data.visceralFat >= 0 && data.visceralFat <= 60 &&
             data.bmi is number && data.bmi > 0 && data.bmi <= 150 &&
             data.bmrKcal is number && data.bmrKcal >= 0 && data.bmrKcal <= 10000 &&
             data.notes is string && data.notes.size() <= 500;
    }

    function isValidWorkoutLoadLog(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.clientId is string && data.clientId.size() >= 1 && data.clientId.size() <= 128 &&
             data.planId is string && data.planId.size() <= 128 &&
             data.planItemId is string && data.planItemId.size() <= 128 &&
             data.exerciseId is string && data.exerciseId.size() <= 128 &&
             data.exerciseName is string && data.exerciseName.size() >= 1 && data.exerciseName.size() <= 120 &&
             data.loadKg is string && data.loadKg.size() >= 1 && data.loadKg.size() <= 40 &&
             data.numericKg is number && data.numericKg >= 0 && data.numericKg <= 2000 &&
             data.loggedAtMillis is int && data.loggedAtMillis >= 0;
    }

    function isValidWaitlistEntry(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.sessionId is string && data.sessionId.size() >= 1 && data.sessionId.size() <= 128 &&
             data.weekKey is string && data.weekKey.size() >= 1 && data.weekKey.size() <= 30 &&
             data.clientId is string && data.clientId.size() >= 1 && data.clientId.size() <= 128 &&
             data.createdAtMillis is int && data.createdAtMillis >= 0;
    }

    function isValidStudioAnnouncement(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.message is string && data.message.size() >= 1 && data.message.size() <= 1200 &&
             data.durationDays is int && data.durationDays >= 1 && data.durationDays <= 90 &&
             data.createdAtMillis is int && data.createdAtMillis >= 0 &&
             data.expiresAtMillis is int && data.expiresAtMillis >= data.createdAtMillis &&
             data.active is bool;
    }

    function isValidAnnouncementRead(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.announcementId is string && data.announcementId.size() >= 1 && data.announcementId.size() <= 128 &&
             data.clientId is string && data.clientId.size() >= 1 && data.clientId.size() <= 128 &&
             data.clientName is string && data.clientName.size() >= 1 && data.clientName.size() <= 100 &&
             data.readAtMillis is int && data.readAtMillis >= 0;
    }

    function isValidWorkoutFeedback(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.clientId is string && data.clientId.size() >= 1 && data.clientId.size() <= 128 &&
             data.clientName is string && data.clientName.size() >= 1 && data.clientName.size() <= 100 &&
             data.planId is string && data.planId.size() <= 128 &&
             data.planTitle is string && data.planTitle.size() >= 1 && data.planTitle.size() <= 120 &&
             data.rpe is int && data.rpe >= 1 && data.rpe <= 10 &&
             data.feeling in ['LEVE', 'IDEAL', 'PESADO'] &&
             data.note is string && data.note.size() <= 400 &&
             data.timestampMillis is int && data.timestampMillis >= 0;
    }

    // --- PT Registration & Approval (Admin: pafm77pedrinho77@gmail.com) ---
    match /pt_accounts/{ptUid} {
      allow get: if isSuperAdmin() || (isSignedIn() && request.auth.uid == ptUid);
      allow list: if isSuperAdmin();
      allow create: if isSignedIn() && request.auth.uid == ptUid && isValidId(ptUid) &&
                       incoming().uid == request.auth.uid &&
                       incoming().keys().hasAll(['uid', 'email', 'displayName', 'status', 'isAdmin', 'requestedAtMillis', 'reviewedAtMillis', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['uid', 'email', 'displayName', 'status', 'isAdmin', 'requestedAtMillis', 'reviewedAtMillis', 'createdAt', 'updatedAt']) &&
                       isValidTimestamp(incoming().createdAt) && isValidTimestamp(incoming().updatedAt) &&
                       isValidPtAccount(incoming()) &&
                       (
                         (isSuperAdmin() && incoming().isAdmin == true && incoming().status == 'APPROVED') ||
                         (!isSuperAdmin() && incoming().isAdmin == false && incoming().status == 'PENDING')
                       );
      allow update: if isSuperAdmin() && isValidId(ptUid) &&
                       isValidPtAccount(incoming()) &&
                       incoming().uid == existing().uid &&
                       incoming().email == existing().email &&
                       incoming().isAdmin == existing().isAdmin &&
                       incoming().createdAt == existing().createdAt &&
                       isValidTimestamp(incoming().updatedAt) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'reviewedAtMillis', 'displayName', 'updatedAt']);
      allow delete: if isSuperAdmin() && isValidId(ptUid);
    }

    // --- User-Scoped Subcollections ---
    match /users/{userId} {
      allow read, write: if false;

      match /clients/{clientId} {
        allow get: if canAccessStudio(userId) && isValidId(clientId);
        allow list: if canAccessStudio(userId);
        allow create: if canAccessStudio(userId) && isValidId(clientId) &&
                         incoming().userId == userId &&
                         incoming().keys().hasAll(['userId', 'name', 'phone', 'notes', 'active', 'newClient', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'name', 'phone', 'notes', 'active', 'newClient', 'monthlyFeeEur', 'fidelizacaoMonths', 'fidelizacaoStartMillis', 'trainingType', 'weeklySessionLimit', 'fixedSlots', 'loginPinHash', 'birthDate', 'weeklyGoalSessions', 'createdAt', 'updatedAt']) &&
                         (!('fixedSlots' in incoming()) || incoming().fixedSlots.size() == 0 || isSuperAdmin()) &&
                         isValidTimestamp(incoming().createdAt) && isValidTimestamp(incoming().updatedAt) &&
                         isValidClient(incoming());
        allow update: if canAccessStudio(userId) && isValidId(clientId) &&
                         isValidClient(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidTimestamp(incoming().updatedAt) &&
                         (
                           (
                             isOwner(userId) &&
                             (!('fixedSlots' in incoming().diff(existing()).affectedKeys()) || isSuperAdmin()) &&
                             incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'notes', 'active', 'newClient', 'monthlyFeeEur', 'fidelizacaoMonths', 'fidelizacaoStartMillis', 'trainingType', 'weeklySessionLimit', 'fixedSlots', 'loginPinHash', 'birthDate', 'weeklyGoalSessions', 'updatedAt'])
                           ) ||
                           (
                             isStudioMember(userId) &&
                             incoming().diff(existing()).affectedKeys().hasOnly(['loginPinHash', 'updatedAt']) &&
                             (
                               (
                                 (!('loginPinHash' in existing()) || existing().loginPinHash == '') &&
                                 incoming().loginPinHash is string &&
                                 incoming().loginPinHash.size() >= 20
                               ) ||
                               (
                                 get(/databases/$(database)/documents/users/$(userId)/portal_members/$(request.auth.uid)).data.clientId == clientId
                               )
                             )
                           ) ||
                           (
                             isStudioMember(userId) &&
                             incoming().diff(existing()).affectedKeys().hasOnly(['birthDate', 'updatedAt'])
                           )
                         );
        allow delete: if isOwner(userId) && isSuperAdmin() && isValidId(clientId);
      }

      match /weeks/{weekId} {
        allow get: if canAccessStudio(userId) && isValidId(weekId);
        allow list: if canAccessStudio(userId);
        allow create: if isOwner(userId) && isValidId(weekId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll(['userId', 'weekKey', 'label', 'startDateMillis', 'published', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'weekKey', 'label', 'startDateMillis', 'published', 'showDayWorkoutTypes', 'dayWorkoutTypes', 'createdAt', 'updatedAt']) &&
                         isValidTimestamp(incoming().createdAt) && isValidTimestamp(incoming().updatedAt) &&
                         isValidWeek(incoming());
        allow update: if isOwner(userId) && isValidId(weekId) &&
                         isValidWeek(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidTimestamp(incoming().updatedAt) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['label', 'published', 'showDayWorkoutTypes', 'dayWorkoutTypes', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(weekId);
      }

      match /sessions/{sessionId} {
        allow get: if canAccessStudio(userId) && isValidId(sessionId);
        allow list: if canAccessStudio(userId);
        allow create: if isOwner(userId) && isValidId(sessionId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll(['userId', 'weekKey', 'dayOfWeek', 'dateLabel', 'timeLabel', 'durationMinutes', 'capacity', 'note', 'startMillis', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'weekKey', 'dayOfWeek', 'dateLabel', 'timeLabel', 'durationMinutes', 'capacity', 'note', 'startMillis', 'ptPrivatePersonal', 'createdAt', 'updatedAt']) &&
                         isValidTimestamp(incoming().createdAt) && isValidTimestamp(incoming().updatedAt) &&
                         isValidSession(incoming());
        allow update: if isOwner(userId) && isValidId(sessionId) &&
                         isValidSession(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidTimestamp(incoming().updatedAt) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['timeLabel', 'durationMinutes', 'capacity', 'note', 'startMillis', 'ptPrivatePersonal', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(sessionId);
      }

      match /bookings/{bookingId} {
        allow get: if canAccessStudio(userId) && isValidId(bookingId);
        allow list: if canAccessStudio(userId);
        allow create: if canAccessStudio(userId) && isValidId(bookingId) &&
                         incoming().userId == userId &&
                         (isOwner(userId) || incoming().status in ['PENDING', 'ALTERED']) &&
                         (isOwner(userId) || !('attendanceStatus' in incoming()) || incoming().attendanceStatus == '') &&
                         incoming().keys().hasAll(['userId', 'sessionId', 'weekKey', 'clientId', 'status', 'requestedAtMillis', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'sessionId', 'weekKey', 'clientId', 'status', 'attendanceStatus', 'requestedAtMillis', 'createdAt', 'updatedAt']) &&
                         isValidTimestamp(incoming().createdAt) && isValidTimestamp(incoming().updatedAt) &&
                         isValidBooking(incoming());
        allow update: if canAccessStudio(userId) && isValidId(bookingId) &&
                         isValidBooking(incoming()) &&
                         (isOwner(userId) || incoming().status in ['ALTERED', 'CANCELLED']) &&
                         (isOwner(userId) || !('attendanceStatus' in incoming().diff(existing()).affectedKeys())) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidTimestamp(incoming().updatedAt) &&
