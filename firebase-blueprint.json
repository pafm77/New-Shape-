      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "notes": { "type": "string" },
        "active": { "type": "boolean" },
        "newClient": { "type": "boolean" },
